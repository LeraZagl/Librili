@model MyLibrary.Models.Book
@{ ViewData["Title"] = "Добавить книгу"; }

<h2 class="mb-4">Добавить книгу</h2>
<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <partial name="_BookForm" model="Model" />
    <button type="submit" class="btn btn-lib-primary">Сохранить</button>
    <a asp-action="Index" class="btn btn-link">Отмена</a>
</form>

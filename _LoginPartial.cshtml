@using Microsoft.AspNetCore.Identity
@using MyLibrary.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav align-items-lg-center">
@if (SignInManager.IsSignedIn(User))
{
    <li class="nav-item text-light me-3" style="font-size:.9rem">👤 @UserManager.GetUserName(User)</li>
    <li class="nav-item">
        <form class="d-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Books", new { area = "" })" method="post">
            <button type="submit" class="btn btn-outline-lib btn-sm">Выйти</button>
        </form>
    </li>
}
else
{
    <li class="nav-item"><a class="nav-link" asp-area="Identity" asp-page="/Account/Register">Регистрация</a></li>
    <li class="nav-item"><a class="btn btn-lib-primary btn-sm" asp-area="Identity" asp-page="/Account/Login">Вход</a></li>
}
</ul>

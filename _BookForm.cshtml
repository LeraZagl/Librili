@model MyLibrary.Models.Book
@using MyLibrary.Models

<div class="row">
    <div class="col-md-8">
        <div class="mb-3">
            <label asp-for="Title" class="form-label"></label>
            <input asp-for="Title" class="form-control" />
            <span asp-validation-for="Title" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Author" class="form-label"></label>
            <input asp-for="Author" class="form-control" />
            <span asp-validation-for="Author" class="text-danger small"></span>
        </div>
        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="Genre" class="form-label"></label>
                <input asp-for="Genre" class="form-control" placeholder="Например: Фантастика" />
            </div>
            <div class="col-md-3 mb-3">
                <label asp-for="Year" class="form-label"></label>
                <input asp-for="Year" class="form-control" />
            </div>
            <div class="col-md-3 mb-3">
                <label asp-for="Rating" class="form-label"></label>
                <input asp-for="Rating" class="form-control" type="number" step="0.5" min="0" max="5" />
            </div>
        </div>
        <div class="row">
            <div class="col-md-4 mb-3">
                <label asp-for="Pages" class="form-label"></label>
                <input asp-for="Pages" class="form-control" />
            </div>
            <div class="col-md-4 mb-3">
                <label asp-for="CurrentPage" class="form-label"></label>
                <input asp-for="CurrentPage" class="form-control" />
            </div>
            <div class="col-md-4 mb-3">
                <label asp-for="Status" class="form-label"></label>
                <select asp-for="Status" asp-items="Html.GetEnumSelectList<ReadStatus>()" class="form-select"></select>
            </div>
        </div>
        <div class="mb-3">
            <label asp-for="CoverUrl" class="form-label"></label>
            <input asp-for="CoverUrl" class="form-control" placeholder="https://..." />
        </div>
        <div class="mb-3">
            <label asp-for="Notes" class="form-label"></label>
            <textarea asp-for="Notes" class="form-control" rows="4" placeholder="Впечатления, цитаты, заметки..."></textarea>
        </div>
        <div class="form-check mb-3">
            <input asp-for="IsFavorite" class="form-check-input" />
            <label asp-for="IsFavorite" class="form-check-label">Добавить в избранное</label>
        </div>
    </div>
</div>
